# =============================================================================
# HOMELY Meals — STAGE frontend (Vercel free tier)
# =============================================================================
# Setup:
#   1. Copy this file (values stay on your machine only):
#        copy .env.stage.example .env.stage        (Windows)
#        cp .env.stage.example .env.stage          (Mac/Linux)
#   2. Set REACT_APP_SERVER_DOMIN to your Render stage backend URL (no trailing slash)
#   3. Set REACT_APP_RAZORPAY_KEY_ID to the same rzp_test_... key as local / backend/.env
#   4. Paste these into Vercel → Settings → Environment Variables (Production)
#   5. Redeploy Vercel after any change (CRA bakes env vars at build time)
#
# File .env.stage is gitignored — never commit it.
#
# Note: Variable name is REACT_APP_SERVER_DOMIN (typo) — must match exactly.
# =============================================================================

# Render stage backend URL (no trailing slash)
REACT_APP_SERVER_DOMIN=https://homely-meals-api.onrender.com

# Same as local — Razorpay TEST mode public key
REACT_APP_RAZORPAY_KEY_ID=

# Optional — reCAPTCHA v2 site key (pairs with RECAPTCHA_SECRET_KEY on backend)
REACT_APP_RECAPTCHA_SITE_KEY=

