# =============================================================================
# HOMELY Meals — Frontend environment variables (LOCAL)
# =============================================================================
# Setup:
#   1. Copy this file to .env:
#        cp .env.example .env          (Mac/Linux)
#        copy .env.example .env        (Windows PowerShell / CMD)
#   2. Fill in REACT_APP_RAZORPAY_KEY_ID (same test key as backend RAZORPAY_KEY_ID)
#   3. Restart the dev server after changes: npm start
#
# STAGE (Vercel + Render): copy .env.stage.example → .env.stage — see README.
# Both .env and .env.stage are gitignored.
#
# Note: Create React App only reads variables prefixed with REACT_APP_
# Note: Variable name is SERVER_DOMIN (typo) — must match exactly; do not rename.
# =============================================================================

# Backend API base URL (no trailing slash)
# Local: http://localhost:8080
# Production (Render): https://your-backend.onrender.com
REACT_APP_SERVER_DOMIN=http://localhost:8080

# Razorpay public key — same value as RAZORPAY_KEY_ID in backend/.env
# REQUIRED for Razorpay Checkout on the cart page
REACT_APP_RAZORPAY_KEY_ID=

# Google reCAPTCHA v2 site key (optional — login works without it if backend secret is also unset)
# Must pair with RECAPTCHA_SECRET_KEY in backend/.env
REACT_APP_RECAPTCHA_SITE_KEY=