# =============================================================================
# HOMELY Meals — Backend environment variables (LOCAL)
# =============================================================================
# Setup:
#   1. Copy this file to .env:
#        cp .env.example .env          (Mac/Linux)
#        copy .env.example .env        (Windows PowerShell / CMD)
#   2. Fill in every value marked REQUIRED
#   3. Start the server: npm run dev
#
# STAGE (Vercel + Render): copy .env.stage.example → .env.stage — see README.
# Both .env and .env.stage are gitignored.
# =============================================================================

# --- Server ---
# Express API port (defaults to 8080 if omitted)
PORT=8080

# Frontend origin for CORS (no trailing slash)
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Max API requests per IP per 15 minutes (default: 200)
RATE_LIMIT_MAX=200

# --- Database ---
# MongoDB connection string from MongoDB Atlas or local MongoDB
# REQUIRED
MONGODB_URL=

# --- Authentication ---
# Secret used to sign JWT tokens — use a long random string in production
# REQUIRED
JWT_SECRET=your_jwt_secret_key_here

# --- Razorpay (payments) ---
# Test keys from https://dashboard.razorpay.com/app/keys (use rzp_test_... in dev)
# REQUIRED for checkout and payment verification
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Razorpay webhook (backup payment confirmation) ---
# Generate a random secret (see README "Razorpay Webhook Setup")
# Public HTTPS URL pointing to POST /api/payments/razorpay/webhook
#   Local dev: use ngrok, e.g. https://abc123.ngrok-free.app/api/payments/razorpay/webhook
#   Production: https://your-backend.onrender.com/api/payments/razorpay/webhook
# REQUIRED for webhook backup; run npm run setup:webhook after setting these
RAZORPAY_WEBHOOK_SECRET=
WEBHOOK_URL=

# --- Email (Resend) ---
# API key from https://resend.com/api-keys
# Optional: order receipts and contact form emails are skipped if empty
RESEND_API_KEY=

# Sender address — must use a verified domain in production
# Default works in Resend sandbox (homely_meals@resend.dev)
FROM_EMAIL=HOMELY Meals <homely_meals@resend.dev>

# Where contact-form submissions are delivered
CONTACT_EMAIL=your-email@example.com

# Resend sandbox only delivers to your Resend account email.
# Set this to that email so order receipts to other addresses are redirected in dev.
RESEND_SANDBOX_EMAIL=your-email@example.com
