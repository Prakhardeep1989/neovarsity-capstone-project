# =============================================================================
# HOMELY Meals — STAGE backend (Render free tier)
# =============================================================================
# Setup:
#   1. Copy this file (values stay on your machine only):
#        copy .env.stage.example .env.stage        (Windows)
#        cp .env.stage.example .env.stage          (Mac/Linux)
#   2. Copy Razorpay + Resend values from backend/.env (same TEST / sandbox keys)
#   3. Use a SEPARATE database on the same Atlas M0 cluster, e.g. homely-stage:
#        mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/homely-stage?retryWrites=true&w=majority
#   4. Deploy backend on Render, then paste these values into Render → Environment
#   5. After Vercel deploy, set FRONTEND_URL to your Vercel URL and redeploy Render
#   6. Register webhook: npm run setup:webhook:stage
#
# File .env.stage is gitignored — never commit it.
# =============================================================================

NODE_ENV=production
PORT=8080

# Vercel stage frontend URL (no trailing slash) — production domain when available
# Comma-separate multiple URLs if needed
FRONTEND_URL=https://your-app-stage.vercel.app

# Allow any https://*.vercel.app preview deployment (stage only — do not use in production)
CORS_ALLOW_VERCEL_PREVIEWS=true

RATE_LIMIT_MAX=200

# Same M0 cluster as local, different database name (e.g. homely-stage)
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/homely-stage?retryWrites=true&w=majority

# Can reuse local JWT_SECRET or generate a separate one for stage
JWT_SECRET=your_stage_jwt_secret_here

# Same as local — Razorpay TEST mode (rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Generate a random secret; use the same value on Render and in Razorpay webhook settings
RAZORPAY_WEBHOOK_SECRET=
WEBHOOK_URL=https://homely-meals-api-stage.onrender.com/api/payments/razorpay/webhook

# Same as local — Resend sandbox
RESEND_API_KEY=
FROM_EMAIL=HOMELY Meals <homely_meals@resend.dev>
CONTACT_EMAIL=your-email@example.com
RESEND_SANDBOX_EMAIL=your-email@example.com
